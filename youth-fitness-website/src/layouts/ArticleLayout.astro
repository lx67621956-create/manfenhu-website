---
import BaseLayout from '@layouts/BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  pubDate?: string;
  date?: string;
  image?: string;
  coverImage?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
}

const {
  title,
  description,
  pubDate,
  date,
  image,
  coverImage,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
} = Astro.props;
const displayDate = pubDate || date;
const displayImage = image || coverImage;
const publishedTime = displayDate ? new Date(displayDate) : undefined;
---

<BaseLayout
  title={`${title}｜满分虎体育`}
  description={description}
  image={ogImage || displayImage}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  imageType={ogImageType}
  article={true}
  publishedTime={publishedTime}
  modifiedTime={publishedTime}
>
  <header class="article-header">
    <div class="container article-header-inner">
      <a class="article-kicker" href="/news/">备考指南</a>
      <h1>{title}</h1>
      <div class="article-meta">
        {displayDate && <time datetime={displayDate}>更新于 {displayDate}</time>}
        <span>满分虎体育</span>
      </div>
    </div>
  </header>

  {displayImage && (
    <div class="article-cover container narrow">
      <img src={displayImage} alt={title} width="1200" height="675" />
    </div>
  )}

  <div class="policy-note container narrow">
    <strong>阅读提示</strong>
    <span>考试政策和评分标准可能调整，涉及报考与考试安排时，请同时核对北京教育考试院最新通知。</span>
  </div>

  <section class="article-content">
    <div class="container narrow">
      <article class="article-body markdown-body">
        <slot />
      </article>
      <aside class="article-cta">
        <div><strong>需要结合孩子情况判断？</strong><p>预约一次基础体测，了解当前项目表现和训练重点。</p></div>
        <a href="/contact/" class="btn btn-primary">预约免费体测</a>
      </aside>
      <div class="article-footer">
        <a href="/news/" class="text-link">返回备考指南</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-header { padding: 68px 0 48px; background: var(--c-surface-warm); }
  .article-header-inner { max-width: 900px; }
  .article-kicker { color: var(--c-primary-dark); font-size: 13px; font-weight: 800; }
  .article-header h1 { max-width: 860px; margin: 14px 0 20px; font-size: 40px; }
  .article-meta { display: flex; gap: 18px; color: var(--c-text-muted); font-size: 13px; }
  .article-cover { margin-top: 40px; }
  .article-cover img { width: 100%; max-height: 520px; object-fit: cover; object-position: center top; border-radius: var(--radius-md); background: var(--c-surface); }
  .policy-note { display: grid; grid-template-columns: 90px 1fr; gap: 16px; margin-top: 24px; padding: 15px 18px; border-left: 3px solid var(--c-primary); background: var(--c-primary-soft); font-size: 13px; }
  .policy-note strong { color: var(--c-ink); }
  .policy-note span { color: var(--c-text-muted); }
  .article-content { padding: 44px 0 72px; }
  .markdown-body { color: var(--c-text); font-size: 17px; line-height: 1.9; }
  .markdown-body :global(p) { margin-bottom: 22px; }
  .markdown-body :global(h2) { margin: 50px 0 22px; padding-bottom: 10px; border-bottom: 1px solid var(--c-border); color: var(--c-ink); font-size: 28px; }
  .markdown-body :global(h3) { margin: 34px 0 16px; color: var(--c-ink); font-size: 22px; }
  .markdown-body :global(h4) { margin: 26px 0 12px; font-size: 18px; }
  .markdown-body :global(ul), .markdown-body :global(ol) { margin: 18px 0 24px; padding-left: 26px; }
  .markdown-body :global(li) { margin-bottom: 9px; }
  .markdown-body :global(img) { max-width: 100%; height: auto; margin: 28px 0; border-radius: var(--radius-md); }
  .markdown-body :global(blockquote) { margin: 28px 0; padding: 18px 20px; border-left: 3px solid var(--c-primary); background: var(--c-surface); color: var(--c-text-muted); }
  .markdown-body :global(blockquote p) { margin-bottom: 0; }
  .markdown-body :global(hr) { margin: 44px 0; border: 0; border-top: 1px solid var(--c-border); }
  .markdown-body :global(strong) { color: var(--c-ink); font-weight: 750; }
  .markdown-body :global(code) { padding: 2px 6px; border-radius: 4px; background: var(--c-surface); font-size: .9em; }
  .markdown-body :global(pre) { margin: 24px 0; padding: 18px 20px; border-radius: var(--radius-md); background: var(--c-surface); overflow-x: auto; }
  .markdown-body :global(table) { display: block; width: 100%; margin: 26px 0; border-collapse: collapse; overflow-x: auto; }
  .markdown-body :global(th), .markdown-body :global(td) { min-width: 120px; padding: 10px 12px; border: 1px solid var(--c-border); text-align: left; }
  .markdown-body :global(th) { background: var(--c-surface); }
  .markdown-body :global(a) { color: var(--c-primary-dark); text-decoration: underline; text-underline-offset: 3px; }
  .article-cta { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px; margin-top: 48px; padding: 28px 30px; border: 1px solid var(--c-border); border-radius: var(--radius-md); background: var(--c-surface); }
  .article-cta strong { color: var(--c-ink); font-size: 18px; }
  .article-cta p { margin: 4px 0 0; color: var(--c-text-muted); }
  .article-footer { margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--c-border); }

  @media (max-width: 680px) {
    .article-header { padding: 50px 0 36px; }
    .article-header h1 { font-size: 31px; }
    .article-cover { margin-top: 20px; }
    .article-cover img { aspect-ratio: 4 / 3; }
    .policy-note { grid-template-columns: 1fr; gap: 4px; }
    .article-content { padding-top: 34px; }
    .markdown-body { font-size: 16px; }
    .markdown-body :global(h2) { font-size: 24px; }
    .article-cta { grid-template-columns: 1fr; padding: 24px 20px; }
  }
</style>

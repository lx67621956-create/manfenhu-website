---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = "满分虎体育专注北京中考体育、少儿体能与手球专项训练，提供体测评估和针对性训练方案。",
  image = "/images/og-default.png",
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <meta property="og:type" content={article ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:locale" content="zh_CN" />
  {article && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {article && tags.map(tag => <meta property="article:tag" content={tag} />)}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  {article ? (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": imageURL.href,
      "datePublished": publishedTime?.toISOString(),
      "dateModified": modifiedTime?.toISOString() || publishedTime?.toISOString(),
      "author": { "@type": "Organization", "name": "满分虎体育" },
      "publisher": { "@type": "Organization", "name": "满分虎体育", "logo": { "@type": "ImageObject", "url": new URL('/images/logo-256.png', Astro.site).href } },
      "mainEntityOfPage": canonicalURL.href
    })} />
  ) : (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": "满分虎体育",
      "description": description,
      "url": Astro.site?.href,
      "telephone": "18600216289",
      "areaServed": "北京市",
      "image": imageURL.href
    })} />
  )}

  <link rel="icon" type="image/png" href="/images/logo-256.png" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="满分虎体育首页">
        <img src="/images/logo-256.png" alt="" width="44" height="44" />
        <span><strong>满分虎体育</strong><small>专注青少年体质提升</small></span>
      </a>

      <nav class="desktop-nav" aria-label="主导航">
        <a class:list={["nav-link", { active: isActive("/") }]} href="/">首页</a>
        <div class="nav-dropdown">
          <a class:list={["nav-link", { active: isActive("/courses/") }]} href="/courses/">课程服务</a>
          <div class="dropdown-menu">
            <a href="/courses/zhongkao/"><strong>中考体育特训</strong><small>体测、选项与专项训练</small></a>
            <a href="/courses/ertong/"><strong>少儿体能训练</strong><small>4-12岁运动基础培养</small></a>
            <a href="/courses/shouqiu/"><strong>手球专项训练</strong><small>技术、体能与团队协作</small></a>
          </div>
        </div>
        <a class:list={["nav-link", { active: isActive("/students/") }]} href="/students/">学员案例</a>
        <a class:list={["nav-link", { active: isActive("/news/") }]} href="/news/">备考指南</a>
        <a class:list={["nav-link", { active: isActive("/contact/") }]} href="/contact/">联系方式</a>
      </nav>

      <div class="header-actions">
        <a class="btn btn-primary header-cta" href="/contact/">预约免费体测</a>
        <button class="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>

    <nav id="mobile-nav" class="mobile-nav" aria-label="移动端导航">
      <div class="container mobile-nav-inner">
        <a href="/">首页</a>
        <span class="mobile-group-title">课程服务</span>
        <a class="mobile-child" href="/courses/zhongkao/">中考体育特训</a>
        <a class="mobile-child" href="/courses/ertong/">少儿体能训练</a>
        <a class="mobile-child" href="/courses/shouqiu/">手球专项训练</a>
        <a href="/students/">学员案例</a>
        <a href="/news/">备考指南</a>
        <a href="/contact/">联系方式</a>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand footer-brand-link">
          <img src="/images/logo-256.png" alt="" width="44" height="44" />
          <span><strong>满分虎体育</strong><small>让训练有目标，让进步可记录</small></span>
        </a>
        <p>面向北京家庭提供中考体育、少儿体能与手球专项训练咨询。</p>
      </div>
      <div class="footer-links">
        <strong>课程服务</strong>
        <a href="/courses/zhongkao/">中考体育特训</a>
        <a href="/courses/ertong/">少儿体能训练</a>
        <a href="/courses/shouqiu/">手球专项训练</a>
      </div>
      <div class="footer-links">
        <strong>了解满分虎</strong>
        <a href="/students/">训练与案例</a>
        <a href="/news/">备考指南</a>
        <a href="/contact/">预约体测</a>
      </div>
      <div class="footer-contact">
        <strong>咨询与预约</strong>
        <a href="tel:18600216289">186 0021 6289</a>
        <span>服务区域：北京市</span>
        <div class="footer-qr-row">
          <img src="/images/wechat-qr-800.png" alt="满分虎体育微信二维码" width="88" height="88" loading="lazy" />
          <small>扫码添加微信<br />咨询课程与体测</small>
        </div>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>&copy; {new Date().getFullYear()} 满分虎体育</span>
      <span>课程安排与训练地点以预约确认为准</span>
    </div>
  </footer>

  <div class="mobile-action-bar" aria-label="快捷咨询">
    <a href="tel:18600216289">电话咨询</a>
    <a href="/contact/">预约免费体测</a>
  </div>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

    function closeMenu() {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', '打开菜单');
      mobileNav?.classList.remove('open');
      document.body.classList.remove('menu-open');
    }

    toggle?.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(opening));
      toggle.setAttribute('aria-label', opening ? '关闭菜单' : '打开菜单');
      mobileNav?.classList.toggle('open', opening);
      document.body.classList.toggle('menu-open', opening);
    });
    mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });

    const revealItems = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach(item => observer.observe(item));
    } else {
      revealItems.forEach(item => item.classList.add('is-visible'));
    }
  </script>
</body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--c-border); background: rgba(255,255,255,.96); backdrop-filter: blur(14px); }
  .header-inner { display: flex; align-items: center; min-height: 76px; gap: 28px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; flex: 0 0 auto; }
  .brand img { border-radius: 6px; }
  .brand span { display: grid; line-height: 1.2; }
  .brand strong { color: var(--c-ink); font-size: 18px; }
  .brand small { margin-top: 3px; color: var(--c-text-muted); font-size: 11px; }
  .desktop-nav { display: flex; align-items: stretch; gap: 4px; margin-left: auto; }
  .nav-link { display: flex; align-items: center; min-height: 76px; padding: 0 13px; color: #3e4b53; font-size: 15px; font-weight: 600; }
  .nav-link:hover, .nav-link.active { color: var(--c-primary-dark); }
  .nav-dropdown { position: relative; }
  .nav-dropdown > .nav-link::after { content: ""; width: 6px; height: 6px; margin: -3px 0 0 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
  .dropdown-menu { position: absolute; top: calc(100% - 8px); left: 50%; width: 280px; padding: 8px; border: 1px solid var(--c-border); border-radius: var(--radius-md); background: #fff; box-shadow: var(--shadow-md); opacity: 0; visibility: hidden; transform: translate(-50%, 8px); transition: .18s ease; }
  .nav-dropdown:hover .dropdown-menu, .nav-dropdown:focus-within .dropdown-menu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .dropdown-menu a { display: grid; gap: 2px; padding: 12px; border-radius: 6px; }
  .dropdown-menu a:hover { background: var(--c-primary-soft); }
  .dropdown-menu strong { color: var(--c-ink); font-size: 14px; }
  .dropdown-menu small { color: var(--c-text-muted); font-size: 12px; }
  .header-actions { display: flex; align-items: center; gap: 12px; }
  .header-cta { min-height: 42px; padding: 10px 16px; font-size: 14px; white-space: nowrap; }
  .menu-toggle { display: none; width: 44px; height: 44px; padding: 10px; border: 0; border-radius: 6px; background: transparent; }
  .menu-toggle span { display: block; width: 22px; height: 2px; margin: 4px auto; background: var(--c-ink); transition: .2s ease; }
  .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .mobile-nav { display: none; }

  .site-footer { padding: 64px 0 24px; border-top: 1px solid var(--c-border); background: var(--c-surface); }
  .footer-grid { display: grid; grid-template-columns: 1.55fr .8fr .8fr 1.1fr; gap: 44px; }
  .footer-brand p { max-width: 330px; margin: 18px 0 0; color: var(--c-text-muted); font-size: 14px; }
  .footer-links, .footer-contact { display: grid; align-content: start; gap: 9px; font-size: 14px; }
  .footer-links strong, .footer-contact > strong { margin-bottom: 5px; color: var(--c-ink); }
  .footer-links a:hover, .footer-contact a:hover { color: var(--c-primary-dark); }
  .footer-contact span { color: var(--c-text-muted); }
  .footer-qr-row { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
  .footer-qr-row img { border: 1px solid var(--c-border); border-radius: 6px; background: #fff; }
  .footer-qr-row small { color: var(--c-text-muted); line-height: 1.6; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 24px; margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--c-border); color: var(--c-text-muted); font-size: 13px; }
  .mobile-action-bar { display: none; }

  @media (max-width: 1080px) {
    .desktop-nav { gap: 0; }
    .nav-link { padding-inline: 9px; }
  }

  @media (max-width: 860px) {
    .desktop-nav, .header-cta { display: none; }
    .header-actions { margin-left: auto; }
    .menu-toggle { display: block; }
    .mobile-nav { display: block; position: fixed; inset: 77px 0 auto; max-height: calc(100vh - 77px); padding: 10px 0 24px; border-bottom: 1px solid var(--c-border); background: #fff; opacity: 0; visibility: hidden; overflow-y: auto; transform: translateY(-10px); transition: .2s ease; }
    .mobile-nav.open { opacity: 1; visibility: visible; transform: none; }
    .mobile-nav-inner { display: grid; }
    .mobile-nav a, .mobile-group-title { padding: 12px 4px; border-bottom: 1px solid #edf0f2; color: var(--c-ink); font-weight: 700; }
    .mobile-group-title { padding-bottom: 5px; border-bottom: 0; color: var(--c-text-muted); font-size: 12px; }
    .mobile-nav .mobile-child { padding: 9px 4px 9px 18px; color: var(--c-text); font-size: 14px; font-weight: 500; }
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .header-inner { min-height: 68px; }
    .brand img { width: 40px; height: 40px; }
    .brand strong { font-size: 17px; }
    .brand small { display: none; }
    .mobile-nav { top: 69px; max-height: calc(100vh - 69px); }
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-links strong { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; margin-top: 32px; }
    .mobile-action-bar { position: fixed; z-index: 110; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: .8fr 1.2fr; min-height: 60px; padding: 8px 10px; border-top: 1px solid var(--c-border); background: rgba(255,255,255,.98); }
    .mobile-action-bar a { display: flex; align-items: center; justify-content: center; border-radius: 6px; color: var(--c-ink); font-size: 14px; font-weight: 700; }
    .mobile-action-bar a:last-child { background: var(--c-primary); color: #fff; }
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';

const gallery = [
  ['/images/students/students-running.jpg', '耐力跑训练', '800米 / 1000米'],
  ['/images/students/students-jump-rope.jpg', '跳绳训练', '节奏与连续完成'],
  ['/images/students/students-standing-jump.jpg', '立定跳远训练', '起跳与落地动作'],
  ['/images/students/students-situps.jpg', '核心力量训练', '动作质量与稳定性'],
  ['/images/students/students-volleyball.jpg', '排球垫球训练', '动作控制与连续性'],
  ['/images/students/students-football.jpg', '足球专项训练', '移动与技术动作'],
  ['/images/students/students-stretching.jpg', '准备与放松', '训练前后身体准备'],
  ['/images/students/students-coaching.jpg', '教练动作指导', '观察、纠正与反馈'],
];
---

<BaseLayout
  title="训练与学员案例｜满分虎体育"
  description="查看满分虎体育的青少年训练现场和匿名学员训练记录。训练效果与孩子基础、训练频率和持续时间有关。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">训练与案例</span>
      <h1>用训练记录，看见阶段变化</h1>
      <p>每个孩子的起点不同。我们更关注当前表现、训练过程和阶段复测之间的变化。</p>
    </div>
  </section>

  <section class="record-strip">
    <div class="container record-grid">
      <div><span>01</span><strong>初始记录</strong><p>了解项目和动作基础</p></div>
      <div><span>02</span><strong>训练重点</strong><p>明确阶段目标</p></div>
      <div><span>03</span><strong>过程反馈</strong><p>记录训练完成情况</p></div>
      <div><span>04</span><strong>阶段复测</strong><p>对照结果再调整</p></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">训练现场</span>
        <h2>动作、体能与专项内容都要落到训练中</h2>
        <p>以下内容展示不同项目的训练场景，不代表固定课程组合。</p>
      </div>
      <div class="gallery-grid">
        {gallery.map(([image, title, description], index) => (
          <figure class:list={["gallery-item", { wide: index === 0 || index === 5 }]}>
            <img src={image} alt={title} loading="lazy" />
            <figcaption><strong>{title}</strong><span>{description}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-surface">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">匿名训练记录</span>
        <h2>案例重点看“起点、周期和变化”</h2>
        <p>案例已做隐私化处理；不同孩子的训练效果会受到基础、频率、身体状态和持续时间影响。</p>
      </div>
      <div class="case-list">
        <article class="case-item reveal">
          <img src="/images/students/student-growth.jpg" alt="中考体育学员训练记录" loading="lazy" />
          <div class="case-content">
            <span>初三学生 · 训练18个月</span>
            <h3>从接近及格线，到完成阶段目标</h3>
            <div class="case-results">
              <div><small>800米</small><strong>5分10秒</strong><i></i><strong>3分30秒</strong></div>
              <div><small>立定跳远</small><strong>1.55米</strong><i></i><strong>1.90米</strong></div>
            </div>
            <p>训练从耐力节奏、基础力量和动作细节入手，通过较长周期逐步提高项目完成质量。该记录用于展示训练过程，具体效果会因基础、频率和持续时间而异。</p>
          </div>
        </article>
        <article class="case-item reveal">
          <img src="/images/students/student-handball.jpg" alt="青少年手球专项训练记录" loading="lazy" />
          <div class="case-content">
            <span>手球专项学员 · 持续训练6年</span>
            <h3>持续练习手球，助力他成功升入大学</h3>
            <div class="case-results text-results">
              <div><small>起点</small><strong>初中开始接触手球</strong></div>
              <div><small>升学与发展</small><strong>成功升入大学，并继续参与校队训练</strong></div>
            </div>
            <p>训练内容逐步从基础传接球、移动和投掷，延伸到专项体能、团队配合与比赛理解。长期手球训练积累的专项能力、比赛经历和坚持，成为他成长与升学过程中的重要助力。</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container cta-band">
      <div><h2>孩子的起点，需要先测出来</h2><p>预约基础体测，了解当前项目表现和优先训练方向。</p></div>
      <a href="/contact/" class="btn btn-primary btn-lg">预约免费体测</a>
    </div>
  </section>
</BaseLayout>

<style>
  .record-strip { border-bottom: 1px solid var(--c-border); }
  .record-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .record-grid > div { display: grid; padding: 22px 24px; border-right: 1px solid var(--c-border); }
  .record-grid > div:first-child { border-left: 1px solid var(--c-border); }
  .record-grid span { color: var(--c-primary); font-size: 12px; font-weight: 800; }
  .record-grid strong { margin-top: 7px; color: var(--c-ink); }
  .record-grid p { margin: 2px 0 0; color: var(--c-text-muted); font-size: 13px; }

  .gallery-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .gallery-item { position: relative; min-height: 260px; margin: 0; overflow: hidden; border-radius: var(--radius-md); background: var(--c-surface); }
  .gallery-item.wide { grid-column: span 2; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; }
  .gallery-item figcaption { position: absolute; right: 0; bottom: 0; left: 0; display: grid; padding: 32px 16px 14px; background: rgba(10,18,23,.72); color: #fff; }
  .gallery-item figcaption span { color: #dbe3e6; font-size: 12px; }

  .case-list { display: grid; gap: 28px; }
  .case-item { display: grid; grid-template-columns: 360px 1fr; min-height: 340px; border: 1px solid var(--c-border); border-radius: var(--radius-md); background: #fff; overflow: hidden; }
  .case-item > img { width: 100%; height: 100%; object-fit: cover; }
  .case-content { padding: 34px 38px; }
  .case-content > span { color: var(--c-primary-dark); font-size: 13px; font-weight: 800; }
  .case-content h3 { margin: 8px 0 24px; font-size: 25px; }
  .case-content > p { margin: 22px 0 0; color: var(--c-text-muted); }
  .case-results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .case-results > div { display: grid; grid-template-columns: minmax(72px, 1fr) 28px minmax(72px, 1fr); align-items: center; gap: 8px; padding: 14px 16px; border: 1px solid var(--c-border); border-radius: 6px; }
  .case-results small { grid-column: 1 / -1; color: var(--c-text-muted); }
  .case-results strong { color: var(--c-ink); font-size: 15px; white-space: nowrap; }
  .case-results i { position: relative; width: 20px; height: 1px; background: var(--c-primary); }
  .case-results i::after { content: ""; position: absolute; top: -3px; right: 0; width: 6px; height: 6px; border-top: 1px solid var(--c-primary); border-right: 1px solid var(--c-primary); transform: rotate(45deg); }
  .text-results > div { grid-template-columns: 1fr; }
  .text-results strong { white-space: normal; }

  @media (max-width: 900px) {
    .record-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .record-grid > div:nth-child(3) { border-left: 1px solid var(--c-border); border-top: 1px solid var(--c-border); }
    .record-grid > div:nth-child(4) { border-top: 1px solid var(--c-border); }
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case-item { grid-template-columns: 280px 1fr; }
    .case-results { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .record-grid > div { padding: 16px 12px; }
    .gallery-item, .gallery-item.wide { grid-column: auto; min-height: 220px; }
    .case-item { grid-template-columns: 1fr; }
    .case-item > img { aspect-ratio: 16 / 9; }
    .case-content { padding: 26px 20px; }
    .case-content h3 { font-size: 22px; }
  }
</style>

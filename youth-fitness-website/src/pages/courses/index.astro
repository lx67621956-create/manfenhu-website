---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="课程体系 - 青少年体能培训机构">
  <section class="bg-primary text-primary-content py-16 text-center">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl font-bold mb-2">课程体系</h1>
      <p class="text-white/80">科学分龄，因材施教</p>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow">
          <figure class="h-48 overflow-hidden">
            <img src="/images/courses/zhongkao.jpg.png" alt="中考体育特训" class="w-full h-full object-cover" />
          </figure>
          <div class="card-body p-5">
            <h3 class="card-title text-lg">中考体育特训</h3>
            <p class="text-base-content/60 text-sm mb-4">针对中考体育测试项目，专项提分训练。</p>
            <div class="card-actions">
              <a href="/courses/zhongkao/" class="btn btn-primary btn-sm">查看详情</a>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow">
          <figure class="h-48 overflow-hidden">
            <img src="/images/courses/ertong.jpg.png" alt="少儿体能训练" class="w-full h-full object-cover" />
          </figure>
          <div class="card-body p-5">
            <h3 class="card-title text-lg">少儿体能训练</h3>
            <p class="text-base-content/60 text-sm mb-4">4-12岁少儿基础体能，培养运动兴趣。</p>
            <div class="card-actions">
              <a href="/courses/ertong/" class="btn btn-primary btn-sm">查看详情</a>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow">
          <figure class="h-48 overflow-hidden">
            <img src="/images/courses/shouqiu.jpg.png" alt="手球专项特训" class="w-full h-full object-cover" />
          </figure>
          <div class="card-body p-5">
            <h3 class="card-title text-lg">手球专项特训</h3>
            <p class="text-base-content/60 text-sm mb-4">专业手球技战术训练，培养团队协作。</p>
            <div class="card-actions">
              <a href="/courses/shouqiu/" class="btn btn-primary btn-sm">查看详情</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

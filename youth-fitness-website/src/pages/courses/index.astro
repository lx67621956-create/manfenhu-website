---
import BaseLayout from '@layouts/BaseLayout.astro';

const courses = [
  {
    href: '/courses/zhongkao/',
    image: '/images/courses/zhongkao.webp',
    width: 1600,
    height: 852,
    label: '考试目标',
    title: '中考体育特训',
    audience: '新初二、新初三及有中考体育备考需求的学生',
    description: '从体测、项目表现和动作问题出发，安排阶段训练重点。',
    points: ['项目表现评估', '动作与专项训练', '阶段复测反馈'],
  },
  {
    href: '/courses/ertong/',
    image: '/images/courses/ertong.webp',
    width: 1600,
    height: 852,
    label: '成长基础',
    title: '少儿体能训练',
    audience: '4-12岁，希望建立运动基础和习惯的儿童',
    description: '通过分龄内容发展基础动作、协调、灵敏和力量能力。',
    points: ['分龄训练内容', '基础身体能力', '运动兴趣培养'],
  },
  {
    href: '/courses/shouqiu/',
    image: '/images/courses/shouqiu.webp',
    width: 1600,
    height: 849,
    label: '专项发展',
    title: '手球专项训练',
    audience: '对手球感兴趣或希望发展团队专项能力的青少年',
    description: '从基础技术到专项体能，逐步建立比赛理解和团队协作。',
    points: ['基础技术与脚步', '专项体能训练', '配合与比赛理解'],
  },
];
---

<BaseLayout
  title="课程服务｜满分虎体育"
  description="了解满分虎中考体育、少儿体能和手球专项训练课程。先体测、再明确目标和训练重点。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">课程服务</span>
      <h1>选择适合孩子当前阶段的训练</h1>
      <p>先明确年龄、目标和当前基础，再决定课程类型与训练节奏。</p>
    </div>
  </section>

  <section class="section">
    <div class="container course-list">
      {courses.map((course, index) => (
        <article class="course-row reveal">
          <a class="course-image" href={course.href}>
            <img src={course.image} alt={course.title} width={course.width} height={course.height} loading={index === 0 ? 'eager' : 'lazy'} />
          </a>
          <div class="course-copy">
            <span class="course-label">{course.label}</span>
            <h2>{course.title}</h2>
            <p class="course-audience">适合：{course.audience}</p>
            <p>{course.description}</p>
            <ul class="feature-list">{course.points.map(point => <li>{point}</li>)}</ul>
            <div class="course-actions">
              <a class="btn btn-primary" href={course.href}>查看课程详情</a>
              <a class="text-link" href="/contact/">预约体测</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-surface">
    <div class="container choose-layout">
      <div class="section-heading">
        <span class="eyebrow">怎么选择</span>
        <h2>课程不是越多越好，适合当前目标更重要</h2>
        <p>不确定时，可以先预约一次沟通和基础体测。</p>
      </div>
      <div class="choose-list">
        <div><strong>有明确考试目标</strong><p>优先了解中考体育特训，根据项目表现确定训练重点。</p></div>
        <div><strong>希望改善运动基础</strong><p>优先了解少儿体能，通过分龄训练建立动作和体能基础。</p></div>
        <div><strong>对团队专项感兴趣</strong><p>优先体验手球训练，再根据兴趣和基础规划后续安排。</p></div>
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container cta-band">
      <div><h2>不确定孩子适合哪类课程？</h2><p>告诉我们孩子的年龄、目标和当前情况，先做基础判断。</p></div>
      <a href="/contact/" class="btn btn-primary btn-lg">预约免费体测</a>
    </div>
  </section>
</BaseLayout>

<style>
  .course-list { display: grid; gap: 64px; }
  .course-row { display: grid; grid-template-columns: 1.05fr .95fr; gap: 52px; align-items: center; padding-bottom: 64px; border-bottom: 1px solid var(--c-border); }
  .course-row:nth-child(even) .course-image { order: 2; }
  .course-image { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-md); background: var(--c-surface); }
  .course-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .course-image:hover img { transform: scale(1.025); }
  .course-label { color: var(--c-primary-dark); font-size: 13px; font-weight: 800; }
  .course-copy h2 { margin: 8px 0 12px; font-size: 30px; }
  .course-copy > p { color: var(--c-text-muted); }
  .course-copy .course-audience { color: var(--c-ink); font-weight: 700; }
  .course-actions { display: flex; align-items: center; gap: 22px; margin-top: 26px; }

  .choose-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 72px; }
  .choose-list { border-top: 1px solid var(--c-border); }
  .choose-list > div { display: grid; grid-template-columns: 190px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--c-border); }
  .choose-list strong { color: var(--c-ink); }
  .choose-list p { margin-bottom: 0; color: var(--c-text-muted); }

  @media (max-width: 860px) {
    .course-row, .choose-layout { grid-template-columns: 1fr; gap: 30px; }
    .course-row:nth-child(even) .course-image { order: 0; }
  }
  @media (max-width: 680px) {
    .course-list { gap: 44px; }
    .course-row { padding-bottom: 44px; }
    .course-copy h2 { font-size: 26px; }
    .course-actions { align-items: stretch; flex-direction: column; }
    .choose-list > div { grid-template-columns: 1fr; gap: 6px; }
  }
</style>

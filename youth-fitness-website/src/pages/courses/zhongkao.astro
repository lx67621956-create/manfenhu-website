---
import CourseDetail from '@components/CourseDetail.astro';

const focusItems = [
  { title: '当前表现评估', description: '了解孩子在耐力、力量、动作控制和球类项目中的当前表现。' },
  { title: '耐力与节奏训练', description: '围绕800米、1000米等内容建立配速、呼吸和持续运动能力。' },
  { title: '力量与动作训练', description: '针对引体、仰卧起坐、跳绳、跳远等项目拆解关键动作。' },
  { title: '球类与运动能力', description: '结合选考方向练习技术动作、连续完成能力与临场稳定性。' },
];
const details = [
  { label: '课程形式', value: '小班或个体化训练安排' },
  { label: '训练周期', value: '根据年级、当前基础和目标阶段确定' },
  { label: '训练反馈', value: '阶段复测与训练重点反馈' },
  { label: '地点时间', value: '预约后根据当期开班情况确认' },
];
const faqs = [
  { question: '孩子现在成绩不稳定，适合直接报课吗？', answer: '建议先做基础体测，确认问题来自体能、动作还是临场稳定性，再决定训练重点。' },
  { question: '还没有确定选考项目怎么办？', answer: '可以先梳理孩子现有项目表现和兴趣方向，再结合学校安排了解更适合重点准备的项目。' },
  { question: '临近考试才开始训练来得及吗？', answer: '需要根据剩余时间和当前基础判断。越临近考试，越应优先处理影响得分最明显的问题，并控制训练风险。' },
];
---
<CourseDetail
  title="中考体育特训"
  eyebrow="北京中考体育训练"
  description="从当前得分和动作表现出发，明确薄弱项目，用分阶段训练提升完成质量与稳定性。"
  image="/images/courses/zhongkao.webp"
  audience="正在准备北京初中学考体育现场考试，需要梳理项目和训练重点的学生。"
  outcome="提升基础体能、动作质量和项目稳定性，减少无目标的重复训练。"
  {focusItems}
  {details}
  {faqs}
/>

---
import { getCollection } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('news');
  return articles.map(article => ({
    params: { slug: article.id.replace(/\.md$/, '') },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const { title, date, category, description, image, coverImage } = article.data;
const slug = article.id.replace(/\.md$/, '');

// 相关阅读：同分类优先，其次按日期最近
const all = await getCollection('news');
const others = all.filter(a => a.id !== article.id);
const sameCat = others.filter(a => a.data.category === category);
const related = [...sameCat, ...others.filter(a => a.data.category !== category)]
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

// 上一篇/下一篇：按日期排序
const sorted = [...all].sort((a, b) => b.data.date.localeCompare(a.data.date));
const idx = sorted.findIndex(a => a.id === article.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
const slugOf = (a: any) => a.id.replace(/\.md$/, '');

// 分享数据
const shareUrl = new URL(`/news/${slug}/`, Astro.site).href;
const shareText = description || (title + ' - 满分虎体育');
const shareImage = (image || coverImage) ? new URL(image || coverImage || '', Astro.site).href : '';
---

<ArticleLayout
  title={title}
  description={description}
  date={date}
  image={image || coverImage}
>
  <Content />

  <!-- 分享操作栏 -->
  <div class="share-bar">
    <span class="share-hint">觉得有用？分享给更多家长</span>
    <div class="share-actions">
      <button class="share-btn share-btn-wechat" id="share-wechat" type="button">
        <span class="share-icon">💬</span>分享到微信
      </button>
      <button class="share-btn share-btn-more" id="share-more" type="button">
        <span class="share-icon">🔗</span>复制链接
      </button>
    </div>
  </div>
  <div class="share-toast" id="share-toast" role="status" aria-live="polite"></div>

  <!-- 上一篇/下一篇 -->
  <nav class="article-pager">
    {next ? (
      <a href={`/news/${slugOf(next)}/`} class="pager-link pager-prev">
        <span class="pager-label">下一篇</span>
        <span class="pager-title">{next.data.title}</span>
      </a>
    ) : <span />}
    {prev ? (
      <a href={`/news/${slugOf(prev)}/`} class="pager-link pager-next">
        <span class="pager-label">上一篇</span>
        <span class="pager-title">{prev.data.title}</span>
      </a>
    ) : <span />}
  </nav>

  <!-- 相关阅读 -->
  {related.length > 0 && (
    <section class="related">
      <h2>相关阅读</h2>
      <ul class="related-list">
        {related.map(a => (
          <li>
            <a href={`/news/${slugOf(a)}/`}>
              <img src={a.data.image || a.data.coverImage || '/images/news/default.jpg'} alt="" loading="lazy" />
              <div>
                <span class="related-cat">{a.data.category || '阅读'}</span>
                <strong>{a.data.title}</strong>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</ArticleLayout>

<style>
  /* 分享操作栏 */
  .share-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    margin: 36px 0 0; padding: 16px 20px;
    border: 1px solid var(--c-border); border-radius: var(--radius-md);
    background: var(--c-surface);
  }
  .share-hint { font-size: 14px; color: var(--c-text-muted); }
  .share-actions { display: flex; gap: 10px; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 18px; border-radius: 8px; border: 1px solid var(--c-border);
    background: #fff; color: var(--c-ink); font-size: 14px; font-weight: 600;
    cursor: pointer; transition: all .2s;
  }
  .share-btn:hover { border-color: var(--c-primary); color: var(--c-primary-dark); box-shadow: 0 2px 8px rgba(255,107,53,0.12); }
  .share-btn:active { transform: scale(0.97); }
  .share-btn-wechat { background: #07C160; border-color: #07C160; color: #fff; }
  .share-btn-wechat:hover { background: #06AD56; border-color: #06AD56; color: #fff; }
  .share-icon { font-size: 15px; line-height: 1; }

  /* 轻提示 */
  .share-toast {
    position: fixed; left: 50%; bottom: 80px; transform: translateX(-50%) translateY(10px);
    padding: 10px 20px; border-radius: 8px;
    background: rgba(30, 39, 46, 0.92); color: #fff; font-size: 14px;
    opacity: 0; pointer-events: none; transition: all .25s; z-index: 999;
  }
  .share-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  @media (max-width: 680px) {
    .share-bar { flex-direction: column; align-items: stretch; gap: 12px; padding: 16px; }
    .share-hint { text-align: center; }
    .share-actions { justify-content: center; }
    .share-btn { flex: 1; justify-content: center; }
  }

  /* 上一篇/下一篇 */
  .article-pager {
    display: flex; justify-content: space-between; gap: 16px;
    margin: 40px 0 8px; padding-top: 24px;
    border-top: 1px solid var(--c-border);
  }
  .pager-link {
    flex: 1; max-width: 48%;
    display: flex; flex-direction: column; gap: 4px;
    padding: 14px 18px; border-radius: 10px;
    background: var(--c-surface); border: 1px solid var(--c-border);
    transition: border-color .2s, box-shadow .2s;
  }
  .pager-link:hover { border-color: var(--c-primary); box-shadow: 0 4px 16px rgba(255,107,53,0.1); }
  .pager-next { text-align: right; margin-left: auto; }
  .pager-label { font-size: .78rem; color: var(--c-text-muted); }
  .pager-title {
    font-size: .92rem; font-weight: 600; color: var(--c-text);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* 相关阅读 */
  .related { margin-top: 40px; }
  .related h2 {
    font-size: 1.2rem; font-weight: 700; margin-bottom: 16px; color: var(--c-text);
    padding-bottom: 8px; border-bottom: 2px solid var(--c-border);
  }
  .related-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; list-style: none; padding: 0; }
  .related-list a {
    display: flex; gap: 12px; align-items: center;
    padding: 12px; border-radius: 10px;
    background: var(--c-surface); border: 1px solid var(--c-border);
    transition: border-color .2s, box-shadow .2s;
  }
  .related-list a:hover { border-color: var(--c-primary); box-shadow: 0 4px 16px rgba(255,107,53,0.1); }
  .related-list img { width: 64px; height: 48px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .related-list strong {
    font-size: .85rem; font-weight: 600; color: var(--c-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .related-cat { font-size: .72rem; color: var(--c-primary); display: block; margin-bottom: 2px; }

  @media (max-width: 600px) {
    .related-list { grid-template-columns: 1fr; }
    .article-pager { flex-direction: column; }
    .pager-link { max-width: 100%; }
  }
</style>

<script is:inline>
  // 分享功能：Web Share API 优先，复制链接降级
  (function () {
    var url = <JSON.stringify(shareUrl)>;
    var text = <JSON.stringify(shareText)>;
    var image = <JSON.stringify(shareImage)>;
    var toast = document.getElementById('share-toast');

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toast._t);
      toast._t = setTimeout(function () { toast.classList.remove('show'); }, 2200);
    }

    // 复制链接（含图片可选参数，旧浏览器忽略）
    function copyLink() {
      var done = function () { showToast('链接已复制，去微信粘贴即可分享'); };
      var fail = function () { showToast('复制失败，请长按地址栏手动复制'); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done, fail);
      } else {
        var ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch (e) { fail(); }
        document.body.removeChild(ta);
      }
    }

    // 分享到微信按钮：微信内提示复制；微信外尝试系统分享
    var btnWx = document.getElementById('share-wechat');
    var btnCopy = document.getElementById('share-more');
    var isWeChat = /MicroMessenger/i.test(navigator.userAgent);

    if (btnWx) {
      btnWx.addEventListener('click', function () {
        if (isWeChat) {
          // 微信内：JS-SDK 不可用时引导用户用右上角菜单分享
          showToast('请点右上角「···」分享给好友或群聊');
        } else if (navigator.share) {
          navigator.share({ title: text, text: text, url: url }).catch(function () {});
        } else {
          copyLink();
        }
      });
    }
    if (btnCopy) {
      btnCopy.addEventListener('click', copyLink);
    }
  })();
</script>

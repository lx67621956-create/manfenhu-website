  <script>
    (function(){
      var TOTAL=70, PER_PAGE=10, PAGE_COUNT=7;
      function getPage(){return parseInt(new URLSearchParams(window.location.search).get('page')||'1');}
      function renderPage(p){
        var c=document.querySelectorAll('.news-card');
        for(var i=0;i<c.length;i++)c[i].style.display=(i>=(p-1)*PER_PAGE&&i<p*PER_PAGE)?'':'none';
        var inf=document.getElementById('pagination-info');
        if(inf)inf.textContent='显示第 '+((p-1)*PER_PAGE+1)+'-'+Math.min(p*PER_PAGE,TOTAL)+' 条，共 '+TOTAL+' 条';
        var pv=document.getElementById('page-prev'),nx=document.getElementById('page-next');
        if(pv)pv.className='page-prev '+(p>1?'':'disabled');
        if(nx)nx.className='page-next '+(p<PAGE_COUNT?'':'disabled');
        document.querySelectorAll('.page-num').forEach(function(b){b.className='page-num '+(parseInt(b.dataset.page)===p?'active':'');});
        (document.querySelector('.section')||document.querySelector('main')).scrollIntoView({behavior:'smooth',block:'start'});
        var u=new URL(window.location);u.searchParams.set('page',p);window.history.replaceState({},'',u);
      };
      document.addEventListener('DOMContentLoaded',function(){
        renderPage(getPage());
        document.querySelectorAll('.page-num').forEach(function(b){b.style.cursor='pointer';b.addEventListener('click',function(){renderPage(parseInt(this.dataset.page));});});
        var pv=document.getElementById('page-prev'),nx=document.getElementById('page-next');
        if(pv)pv.addEventListener('click',function(){var p=getPage();if(p>1)renderPage(p-1);});
        if(nx)nx.addEventListener('click',function(){var p=getPage();if(p<PAGE_COUNT)renderPage(p+1);});
      });
    })();
  </script>


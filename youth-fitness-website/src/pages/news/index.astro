---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import NewsList from '@components/NewsList.astro';

const all = await getCollection('news');
all.sort((a, b) => b.data.date.localeCompare(a.data.date) || (b.data.order ?? 0) - (a.data.order ?? 0));
const PER_PAGE = 12;
const totalPages = Math.ceil(all.length / PER_PAGE);
const pageArticles = all.slice(0, PER_PAGE);
---

<BaseLayout
  title="北京中考体育备考指南｜满分虎体育"
  description="查看北京中考体育政策、项目训练、运动健康与家长指南。政策信息请同时以北京教育考试院最新通知为准。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">备考指南</span>
      <h1>把政策、项目和训练方法看明白</h1>
      <p>围绕北京中考体育、青少年体能与运动训练持续整理实用内容。</p>
    </div>
  </section>
  <div class="guide-note">
    <div class="container"><strong>政策提醒</strong><span>考试政策和评分标准可能调整，报考与考试安排请以北京教育考试院最新通知为准。</span></div>
  </div>
  <NewsList {pageArticles} currentPage={1} {totalPages} />
</BaseLayout>

<style>
  .guide-note { border-bottom: 1px solid var(--c-border); background: var(--c-surface); }
  .guide-note .container { display: flex; gap: 18px; padding-block: 14px; font-size: 13px; }
  .guide-note strong { color: var(--c-primary-dark); }
  .guide-note span { color: var(--c-text-muted); }
  @media (max-width: 680px) { .guide-note .container { flex-direction: column; gap: 3px; } }
</style>

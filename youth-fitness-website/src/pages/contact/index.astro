---
import BaseLayout from '@layouts/BaseLayout.astro';

const surveyUrl = 'https://wj.qq.com/s2/26539023/0ba7';
---

<BaseLayout
  title="预约免费体测｜满分虎体育"
  description="预约满分虎体育免费基础体测，咨询北京中考体育、少儿体能和手球专项训练安排。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">咨询与预约</span>
      <h1>先了解孩子当前情况，再决定怎么练</h1>
      <p>准备好孩子的年龄、训练目标和目前项目表现，我们会帮助梳理下一步。</p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-layout">
      <div class="contact-primary">
        <div class="section-heading">
          <span class="eyebrow">直接咨询</span>
          <h2>选择方便的联系方式</h2>
          <p>电话适合快速确认课程与时间；微信适合发送孩子当前成绩和项目情况。</p>
        </div>
        <div class="contact-methods">
          <div class="contact-method">
            <span class="method-number">01</span>
            <div><strong>电话咨询</strong><a href="tel:18600216289">186 0021 6289</a><p>可直接说明孩子年级和训练目标。</p></div>
            <a class="btn btn-primary" href="tel:18600216289">拨打电话</a>
          </div>
          <div class="contact-method qr-method">
            <span class="method-number">02</span>
            <div><strong>微信咨询</strong><p>扫码添加微信，发送孩子当前情况。</p></div>
            <img src="/images/wechat-qr-800.png" alt="满分虎体育微信二维码" width="128" height="128" />
          </div>
        </div>
      </div>

      <aside class="booking-panel">
        <span class="panel-label">在线登记</span>
        <h2>填写预约信息</h2>
        <p>通过腾讯问卷登记基本情况，工作人员会根据课程安排与您联系。</p>
        <ul class="feature-list">
          <li>孩子年龄与年级</li>
          <li>目前训练目标</li>
          <li>方便联系的方式</li>
        </ul>
        <a href={surveyUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">填写预约信息</a>
        <small>将打开腾讯问卷，提交前请阅读其隐私说明。</small>
      </aside>
    </div>
  </section>

  <section class="section section-surface">
    <div class="container visit-layout">
      <div class="section-heading">
        <span class="eyebrow">预约前准备</span>
        <h2>提前准备三项信息，沟通更高效</h2>
      </div>
      <ol class="visit-steps">
        <li><span>01</span><h3>孩子的年级</h3><p>不同阶段的目标和训练节奏不同。</p></li>
        <li><span>02</span><h3>当前项目表现</h3><p>可以提供最近一次成绩或遇到的问题。</p></li>
        <li><span>03</span><h3>方便训练的时间</h3><p>用于匹配近期课程与体验安排。</p></li>
      </ol>
    </div>
  </section>

  <section class="section service-section">
    <div class="container service-layout">
      <div><span>服务区域</span><strong>北京市</strong><p>具体训练地点在预约时根据课程类型和当期安排确认。</p></div>
      <div><span>课程方向</span><strong>三类训练服务</strong><p>中考体育、少儿体能、手球专项。</p></div>
      <div><span>开始方式</span><strong>沟通与基础体测</strong><p>先了解当前情况，再确认课程安排。</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout { display: grid; grid-template-columns: 1.12fr .88fr; gap: 72px; align-items: start; }
  .contact-methods { border-top: 1px solid var(--c-border); }
  .contact-method { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 18px; padding: 24px 0; border-bottom: 1px solid var(--c-border); }
  .method-number { color: var(--c-primary); font-size: 12px; font-weight: 800; }
  .contact-method > div { display: grid; }
  .contact-method strong { color: var(--c-ink); font-size: 18px; }
  .contact-method > div > a { width: fit-content; margin-top: 4px; color: var(--c-primary-dark); font-size: 22px; font-weight: 800; }
  .contact-method p { margin: 4px 0 0; color: var(--c-text-muted); font-size: 14px; }
  .qr-method img { border: 1px solid var(--c-border); border-radius: 6px; }

  .booking-panel { padding: 36px; border: 1px solid #f3b29c; border-radius: var(--radius-md); background: var(--c-surface-warm); }
  .panel-label { color: var(--c-primary-dark); font-size: 13px; font-weight: 800; }
  .booking-panel h2 { margin: 8px 0 12px; font-size: 28px; }
  .booking-panel > p { color: var(--c-text-muted); }
  .booking-panel .feature-list { margin: 24px 0 28px; }
  .booking-panel .btn { width: 100%; }
  .booking-panel small { display: block; margin-top: 14px; color: var(--c-text-muted); line-height: 1.6; }

  .visit-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 72px; }
  .visit-steps { display: grid; margin: 0; padding: 0; border-top: 1px solid var(--c-border); list-style: none; }
  .visit-steps li { display: grid; grid-template-columns: 44px 180px 1fr; align-items: baseline; gap: 14px; padding: 20px 0; border-bottom: 1px solid var(--c-border); }
  .visit-steps span { color: var(--c-primary); font-size: 12px; font-weight: 800; }
  .visit-steps h3 { margin-bottom: 0; font-size: 17px; }
  .visit-steps p { margin-bottom: 0; color: var(--c-text-muted); }

  .service-layout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); }
  .service-layout > div { display: grid; padding: 28px 30px; border-right: 1px solid var(--c-border); }
  .service-layout > div:first-child { border-left: 1px solid var(--c-border); }
  .service-layout span { color: var(--c-primary-dark); font-size: 12px; font-weight: 800; }
  .service-layout strong { margin-top: 8px; color: var(--c-ink); font-size: 19px; }
  .service-layout p { margin: 8px 0 0; color: var(--c-text-muted); font-size: 14px; }

  @media (max-width: 900px) {
    .contact-layout, .visit-layout { grid-template-columns: 1fr; gap: 42px; }
    .service-layout { grid-template-columns: 1fr; }
    .service-layout > div, .service-layout > div:first-child { border: 0; border-bottom: 1px solid var(--c-border); }
  }
  @media (max-width: 680px) {
    .contact-method { grid-template-columns: 32px 1fr; }
    .contact-method > .btn, .qr-method img { grid-column: 2; width: 100%; }
    .qr-method img { max-width: 180px; }
    .booking-panel { padding: 28px 22px; }
    .visit-steps li { grid-template-columns: 32px 1fr; }
    .visit-steps p { grid-column: 2; }
  }
</style>

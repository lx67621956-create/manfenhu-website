---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="联系我们 - 满分虎体育">
  <section class="page-hero">
    <div class="container">
      <span class="hero-badge">CONTACT</span>
      <h1>联系我们</h1>
      <p>预约体验、课程咨询、合作洽谈，我们随时为您服务</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- 预约表单 -->
        <div class="contact-form-col">
          <h2 class="form-title">在线预约</h2>
          <p class="form-sub">填写信息，我们将在一个工作日内与您联系</p>
          <div class="survey-card">
            <div class="survey-icon">📋</div>
            <h3>预约报名</h3>
            <p>请填写预约信息，我们会尽快与您联系！</p>
            <a href="https://wj.qq.com/s2/26539023/0ba7" target="_blank" rel="noopener" class="btn btn-primary">
              🏃 立即预约报名 →
            </a>
            <p class="survey-note">点击后在腾讯问卷中填写，信息直接进入后台</p>
          </div>
        </div>

        <!-- 联系信息 -->
        <div class="contact-info-col">
          <h2 class="form-title">联系方式</h2>
          <p class="form-sub">您也可以通过以下方式直接联系我们</p>

          <div class="info-card">
            <div class="info-item">
              <span class="info-icon">📞</span>
              <div>
                <strong>联系电话</strong>
                <p>18600216289</p>
              </div>
            </div>
            <div class="info-divider"></div>
            <div class="info-item">
              <span class="info-icon">💬</span>
              <div>
                <strong>微信咨询</strong>
                <p>扫描下方二维码添加好友</p>
              </div>
            </div>
            <div class="info-divider"></div>
            <div class="info-item">
              <span class="info-icon">📍</span>
              <div>
                <strong>训练地址</strong>
                <p>北京市（具体地址预约后告知）</p>
              </div>
            </div>
          </div>

          <div class="qr-section">
            <img src="/images/wechat-qr.png" alt="微信二维码" class="qr-img" />
            <p class="qr-label">扫码添加微信<br/>免费咨询课程</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <h2>不确定从哪开始？</h2>
        <p>告诉我们孩子的情况，免费定制训练方案</p>
        <a href="https://wj.qq.com/s2/26539023/0ba7" target="_blank" class="btn btn-cta">免费咨询 →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.page-hero {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff; padding: 56px 0; text-align: center;
}
.hero-badge {
  display: inline-block; padding: 3px 12px; border-radius: 20px;
  background: rgba(255,255,255,0.2); color: #fff;
  font-size: 0.75rem; font-weight: 600; letter-spacing: 2px; margin-bottom: 12px;
}
.page-hero h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: 8px; }
.page-hero p { font-size: 1rem; opacity: 0.85; max-width: 450px; margin: 0 auto; }

.section { padding: 80px 0; }

.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
@media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; gap: 32px; } }

.form-title { font-size: 1.3rem; font-weight: 700; margin-bottom: 4px; color: #1E272E; }
.form-sub { font-size: 0.88rem; color: #888; margin-bottom: 24px; }

.survey-card {
  background: linear-gradient(135deg, #FFF8F0, #fff);
  border: 2px solid #FF6B35; border-radius: 16px; padding: 40px; text-align: center;
}
.survey-icon { font-size: 3rem; margin-bottom: 12px; }
.survey-card h3 { font-size: 1.3rem; font-weight: 700; margin-bottom: 8px; color: #1E272E; }
.survey-card > p { color: #666; font-size: 0.9rem; margin-bottom: 20px; }
.btn-primary {
  display: inline-block; padding: 14px 32px; border-radius: 8px;
  background: #FF6B35; color: #fff; font-weight: 700; font-size: 1rem;
  transition: all .25s;
}
.btn-primary:hover { background: #E8581F; transform: translateY(-2px); }
.survey-note { font-size: 0.78rem; color: #999; margin-top: 14px; }

.info-card {
  background: #fff; border: 1px solid #eee; border-radius: 16px;
  padding: 24px; margin-bottom: 24px;
}
.info-item { display: flex; gap: 14px; align-items: flex-start; }
.info-icon { font-size: 1.4rem; line-height: 1.4; }
.info-item strong { display: block; font-size: 0.9rem; color: #1E272E; margin-bottom: 2px; }
.info-item p { font-size: 0.88rem; color: #666; margin: 0; }
.info-divider { height: 1px; background: #eee; margin: 16px 0; }

.qr-section {
  text-align: center; padding: 24px; border: 1px solid #eee; border-radius: 16px;
}
.qr-img { width: 140px; height: 140px; border-radius: 8px; margin-bottom: 8px; }
.qr-label { font-size: 0.82rem; color: #666; line-height: 1.5; }

.cta-section { padding: 60px 0; }
.cta-inner {
  text-align: center; padding: 48px; border-radius: 16px;
  background: linear-gradient(135deg, #FF6B35, #FF8C42); color: #fff;
}
.cta-inner h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 6px; }
.cta-inner p { font-size: 0.95rem; opacity: 0.85; margin-bottom: 20px; }
.btn-cta {
  display: inline-block; padding: 12px 36px; border-radius: 8px;
  background: #fff; color: #FF6B35; font-weight: 700; font-size: 0.95rem;
  transition: all .3s;
}
.btn-cta:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
</style>

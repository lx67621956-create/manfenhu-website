---
import BaseLayout from '@layouts/BaseLayout.astro';
---

|<BaseLayout title="满分虎中考体育 — 青少年体能培训专家">
|  <!-- 轮播图 -->
|  <section class="hero-banner">
|    <div class="carousel">
|      <div class="carousel-slides">
|        <div class="carousel-slide active" data-index="0">
|          <img src="/images/banner-zhongkao.jpg" alt="专注青少年体质提升" class="carousel-img" />
|          <div class="carousel-overlay">
|            <h2 class="carousel-title">专注青少年体质提升</h2>
|            <p class="carousel-sub">科学训练，为成长加分</p>
|            <a href="/courses/" class="btn btn-primary btn-lg">了解课程</a>
|          </div>
|        </div>
|        <div class="carousel-slide" data-index="1">
|          <img src="/images/banner-handball.jpg" alt="中考体育提分个体化训练" class="carousel-img" />
|          <div class="carousel-overlay">
|            <h2 class="carousel-title">中考体育提分·个体化训练</h2>
|            <p class="carousel-sub">每个孩子都值得一份专属训练方案</p>
|            <a href="/courses/zhongkao/" class="btn btn-primary btn-lg">了解详情</a>
|          </div>
|        </div>
|        <div class="carousel-slide" data-index="2">
|          <img src="/images/banner-fitness.jpg" alt="手球专业运动员输送" class="carousel-img" />
|          <div class="carousel-overlay">
|            <h2 class="carousel-title">手球专业运动员输送</h2>
|            <p class="carousel-sub">从兴趣到专业，打通体育升学之路</p>
|            <a href="/courses/shouqiu/" class="btn btn-primary btn-lg">了解详情</a>
|          </div>
|        </div>
|      </div>
|      <div class="carousel-dots">
|        <span class="dot active" data-slide="0"></span>
|        <span class="dot" data-slide="1"></span>
|        <span class="dot" data-slide="2"></span>
|      </div>
|      <button class="carousel-arrow carousel-prev" aria-label="上一张">&#10094;</button>
|      <button class="carousel-arrow carousel-next" aria-label="下一张">&#10095;</button>
|    </div>
|  </section>

  <!-- 课程展示占位 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">课程体系</h2>
      <div class="grid-3">
        <div class="card">
          <img src="/images/courses/zhongkao.jpg.png" alt="中考体育特训" class="course-img" />
          <div class="card-body">
            <h3>中考体育特训</h3>
            <p class="text-muted">课程简介待填写</p>
            <a href="/courses/zhongkao/" class="btn btn-outline">了解详情</a>
          </div>
        </div>
        <div class="card">
          <img src="/images/courses/ertong.jpg.png" alt="少儿体能训练" class="course-img" />
          <div class="card-body">
            <h3>少儿体能训练</h3>
            <p class="text-muted">课程简介待填写</p>
            <a href="/courses/ertong/" class="btn btn-outline">了解详情</a>
          </div>
        </div>
        <div class="card">
          <img src="/images/courses/shouqiu.jpg.png" alt="手球专项特训" class="course-img" />
          <div class="card-body">
            <h3>手球专项特训</h3>
            <p class="text-muted">课程简介待填写</p>
            <a href="/courses/shouqiu/" class="btn btn-outline">了解详情</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 机构简介占位 -->
  <section class="section" style="background:var(--c-surface);">
    <div class="container">
      <h2 class="section-title">关于我们</h2>
      <div class="grid-2" style="align-items:center;">
        <div class="video-wrapper">
          <iframe src="https://player.youku.com/embed/XNjI1MjgyNTI0OA==" width="100%" height="100%" frameborder="0" allowfullscreen loading="lazy"></iframe>
        </div>
        <div>
          <h3 style="margin-bottom:16px;">满分虎中考体育</h3>
          <p class="text-muted" style="margin-bottom:24px;">满分虎是针对青少年体质健康与应试满分问题的解决方案。意在通过"提升应试分数"的方式，开启每个中国家庭对于孩子身体素质全面提升的意识；帮助每一位孩子从小建立正确的运动模式、培养终身的运动习惯。</p>
          <a href="/contact/" class="btn btn-primary">预约体验</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-banner { position: relative; max-width: 1200px; margin: 0 auto; border-radius: 0 0 12px 12px; overflow: hidden; }
  .carousel {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
    background: #222;
  }
  .carousel-slides {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .carousel-slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
    z-index: 0;
  }
  .carousel-slide.active {
    opacity: 1;
    z-index: 1;
  }
  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .carousel-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: rgba(0,0,0,0.2);
    color: #fff;
    padding: 24px;
  }
  .carousel-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 12px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
    letter-spacing: 2px;
  }
  .carousel-sub {
    font-size: 1.15rem;
    margin-bottom: 28px;
    opacity: 0.9;
    text-shadow: 0 1px 4px rgba(0,0,0,0.3);
  }
  .btn-lg {
    padding: 14px 40px;
    font-size: 1.05rem;
    border-radius: 8px;
    font-weight: 700;
  }
  .carousel-dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    cursor: pointer;
    transition: background .3s;
  }
  .dot.active {
    background: #fff;
  }
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0,0,0,0.3);
    color: #fff;
    border: none;
    font-size: 1.8rem;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    transition: background .3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .carousel-arrow:hover {
    background: rgba(0,0,0,0.6);
  }
  .carousel-prev { left: 20px; }
  .carousel-next { right: 20px; }
  
  @media (max-width: 768px) {
    .carousel { height: 280px; }
    .carousel-title { font-size: 1.6rem; }
    .carousel-sub { font-size: 1rem; }
    .carousel-arrow { width: 36px; height: 36px; font-size: 1.2rem; }
    .hero-banner { border-radius: 0; }
  }
  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #f0f0f0;
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .card { overflow: hidden; }
  .course-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .card-body { padding: 24px; }
  .card-body h3 { margin-bottom: 8px; }
  .text-muted { color: var(--c-text-muted); }
</style>

<script>
  (function() {
    var slides = document.querySelectorAll('.carousel-slide');
    var dots = document.querySelectorAll('.dot');
    var prev = document.querySelector('.carousel-prev');
    var next = document.querySelector('.carousel-next');
    var current = 0;
    var timer;

    function goTo(index) {
      slides.forEach(function(s, i) {
        s.classList.toggle('active', i === index);
      });
      dots.forEach(function(d, i) {
        d.classList.toggle('active', i === index);
      });
      current = index;
    }

    function nextSlide() {
      goTo((current + 1) % slides.length);
    }

    function prevSlide() {
      goTo((current - 1 + slides.length) % slides.length);
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(nextSlide, 5000);
    }

    if (slides.length) {
      goTo(0);
      timer = setInterval(nextSlide, 5000);
      dots.forEach(function(d) {
        d.addEventListener('click', function() {
          goTo(parseInt(this.dataset.slide));
          resetTimer();
        });
      });
      if (prev) { prev.addEventListener('click', function() { prevSlide(); resetTimer(); }); }
      if (next) { next.addEventListener('click', function() { nextSlide(); resetTimer(); }); }
    }
  })();
</script>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('news');
articles.sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestArticles = articles.slice(0, 3);
---

<BaseLayout
  title="满分虎体育｜北京中考体育与青少年体能训练"
  description="满分虎体育提供北京中考体育、少儿体能和手球专项训练咨询。从体测评估开始，为孩子制定更有针对性的训练方案。"
  image="/images/banner-zhongkao.webp"
>
  <section class="home-hero">
    <img class="home-hero-image" src="/images/banner-zhongkao.webp" alt="青少年进行中考体育专项训练" width="1792" height="1024" fetchpriority="high" />
    <div class="home-hero-shade"></div>
    <div class="container home-hero-content">
      <div class="home-hero-copy">
        <span class="hero-kicker">中考体育 · 少儿体能 · 手球专项</span>
        <h1>北京中考体育专项训练</h1>
        <p>从一次体测开始，找准孩子当前基础、薄弱项目与训练重点，让每一步训练都有目标。</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">预约免费体测</a>
          <a href="/courses/" class="btn btn-secondary btn-lg">查看课程方案</a>
        </div>
        <span class="hero-note">北京市服务 · 训练安排以预约确认为准</span>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="训练服务特点">
    <div class="container trust-grid">
      <div><strong>先体测</strong><span>了解当前基础</span></div>
      <div><strong>定目标</strong><span>明确训练重点</span></div>
      <div><strong>分阶段</strong><span>逐步提升能力</span></div>
      <div><strong>再复测</strong><span>用记录观察变化</span></div>
    </div>
  </section>

  <section class="section audience-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">从孩子当前阶段出发</span>
        <h2>先选对方向，再开始训练</h2>
        <p>不同年龄、目标和运动基础，需要不同的训练节奏。</p>
      </div>
      <div class="audience-grid">
        <a class="audience-item reveal" href="/courses/zhongkao/">
          <span class="audience-index">01</span>
          <div><strong>新初二 / 新初三</strong><h3>中考体育备考</h3><p>体测评估、项目分析、动作训练与阶段复测。</p></div>
          <span class="audience-link">查看方案</span>
        </a>
        <a class="audience-item reveal" href="/courses/ertong/">
          <span class="audience-index">02</span>
          <div><strong>4-12岁儿童</strong><h3>基础体能培养</h3><p>围绕力量、速度、协调、灵敏与运动兴趣打好基础。</p></div>
          <span class="audience-link">查看方案</span>
        </a>
        <a class="audience-item reveal" href="/courses/shouqiu/">
          <span class="audience-index">03</span>
          <div><strong>专项兴趣与进阶</strong><h3>手球专项训练</h3><p>发展专项技术、体能基础、比赛意识与团队协作。</p></div>
          <span class="audience-link">查看方案</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-surface">
    <div class="container">
      <div class="section-heading center">
        <span class="eyebrow">课程服务</span>
        <h2>三条训练路径，对应不同成长目标</h2>
        <p>课程详情以孩子的体测结果、年龄和开班安排为准。</p>
      </div>
      <div class="course-grid">
        <article class="course-card card card-hover reveal">
          <a href="/courses/zhongkao/" class="course-media"><img src="/images/courses/zhongkao.webp" alt="中考体育专项训练" width="1600" height="852" loading="lazy" /></a>
          <div class="course-body">
            <span class="course-label">考试目标</span>
            <h3>中考体育特训</h3>
            <p>围绕孩子的当前得分、选考项目与薄弱动作，制定分阶段训练重点。</p>
            <ul><li>入学体测与项目分析</li><li>动作纠正与专项训练</li><li>阶段复测与训练反馈</li></ul>
            <a class="text-link" href="/courses/zhongkao/">了解中考课程</a>
          </div>
        </article>
        <article class="course-card card card-hover reveal">
          <a href="/courses/ertong/" class="course-media"><img src="/images/courses/ertong.webp" alt="少儿体能训练" width="1600" height="852" loading="lazy" /></a>
          <div class="course-body">
            <span class="course-label course-label-green">成长基础</span>
            <h3>少儿体能训练</h3>
            <p>通过适龄运动任务和游戏化训练，帮助孩子建立动作基础与运动习惯。</p>
            <ul><li>分龄训练内容</li><li>协调、灵敏与力量基础</li><li>关注运动兴趣和参与感</li></ul>
            <a class="text-link" href="/courses/ertong/">了解少儿课程</a>
          </div>
        </article>
        <article class="course-card card card-hover reveal">
          <a href="/courses/shouqiu/" class="course-media"><img src="/images/courses/shouqiu.webp" alt="青少年手球专项训练" width="1600" height="849" loading="lazy" /></a>
          <div class="course-body">
            <span class="course-label course-label-blue">专项发展</span>
            <h3>手球专项训练</h3>
            <p>从基础动作到专项配合，逐步提升技术、体能和比赛理解。</p>
            <ul><li>基础技术与脚步</li><li>专项体能与对抗意识</li><li>团队配合与比赛实践</li></ul>
            <a class="text-link" href="/courses/shouqiu/">了解手球课程</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section method-section">
    <div class="container method-layout">
      <div class="section-heading">
        <span class="eyebrow">训练方法</span>
        <h2>把“练得多”变成“练得更清楚”</h2>
        <p>家长可以知道孩子为什么练、这一阶段练什么、下一步该怎么调整。</p>
        <a href="/contact/" class="btn btn-outline method-cta">预约一次体测</a>
      </div>
      <ol class="method-steps">
        <li><span>01</span><div><h3>初始体测</h3><p>记录当前项目表现和动作情况。</p></div></li>
        <li><span>02</span><div><h3>目标拆解</h3><p>确定优先训练项目和阶段目标。</p></div></li>
        <li><span>03</span><div><h3>专项训练</h3><p>围绕动作、体能和稳定性持续训练。</p></div></li>
        <li><span>04</span><div><h3>阶段复测</h3><p>对照记录复盘，再调整后续计划。</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section section-warm training-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">训练现场</span>
        <h2>看得见的训练内容</h2>
        <p>耐力、力量、球类和动作基础，都需要在真实训练中逐步建立。</p>
      </div>
      <div class="training-grid">
        <figure><img src="/images/students/students-running.jpg" alt="学员进行耐力跑训练" loading="lazy" /><figcaption><strong>耐力与节奏</strong><span>800米 / 1000米训练</span></figcaption></figure>
        <figure><img src="/images/students/students-standing-jump.jpg" alt="学员进行立定跳远动作训练" loading="lazy" /><figcaption><strong>力量与动作</strong><span>起跳、腾空与落地</span></figcaption></figure>
        <figure><img src="/images/students/students-volleyball.jpg" alt="学员进行排球垫球训练" loading="lazy" /><figcaption><strong>球类与稳定性</strong><span>动作控制与连续完成</span></figcaption></figure>
      </div>
      <a href="/students/" class="text-link training-more">查看更多训练与案例</a>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-layout">
      <div class="about-video">
        <iframe src="https://player.youku.com/embed/XNjI1MjgyNTI0OA==" title="满分虎体育训练介绍" loading="lazy" allowfullscreen></iframe>
      </div>
      <div class="about-copy">
        <span class="eyebrow">关于满分虎</span>
        <h2>不只关注一次考试，也关注长期运动能力</h2>
        <p>我们希望先用清晰的目标帮助孩子进入训练，再通过持续的运动体验，逐步建立动作基础、身体能力与运动习惯。</p>
        <ul class="feature-list"><li>根据当前基础安排训练重点</li><li>重视动作质量与训练安全</li><li>通过阶段记录与家长保持沟通</li></ul>
      </div>
    </div>
  </section>

  <section class="section section-surface">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">备考指南</span>
        <h2>先把政策和训练方法看明白</h2>
        <p>围绕北京中考体育项目、训练安排和常见问题持续更新。</p>
      </div>
      <div class="latest-grid">
        {latestArticles.map(article => {
          const slug = article.id.replace(/\.md$/, '');
          const image = article.data.image || article.data.coverImage || '/images/og-default.png';
          return (
            <article class="latest-item card card-hover">
              <a href={`/news/${slug}`}><img src={image} alt={article.data.title} loading="lazy" /></a>
              <div><span>{article.data.category || '备考指南'} · {article.data.date}</span><h3><a href={`/news/${slug}`}>{article.data.title}</a></h3><a class="text-link" href={`/news/${slug}`}>阅读全文</a></div>
            </article>
          );
        })}
      </div>
      <a href="/news/" class="btn btn-outline all-news">查看全部备考内容</a>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container narrow">
      <div class="section-heading center"><span class="eyebrow">常见问题</span><h2>预约前，家长通常会问</h2></div>
      <div class="faq-list">
        <details><summary>第一次到店会直接开始上课吗？</summary><p>建议先进行基础沟通和体测，了解孩子当前项目表现，再确认更合适的训练安排。</p></details>
        <details><summary>还没有确定选考项目，可以咨询吗？</summary><p>可以。咨询时可结合孩子的年级、身体基础和现有项目表现，梳理需要优先了解的方向。</p></details>
        <details><summary>训练地点和开课时间怎么确认？</summary><p>提交预约后，工作人员会根据课程类型和近期排课说明可选时间与训练地点。</p></details>
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container cta-band">
      <div><h2>不知道孩子该从哪里开始？</h2><p>先做一次基础体测，再决定训练项目和节奏。</p></div>
      <a href="/contact/" class="btn btn-primary btn-lg">预约免费体测</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; height: clamp(600px, 50vw, 820px); display: flex; align-items: flex-end; overflow: hidden; background: #e1d0c4; }
  .home-hero-image, .home-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .home-hero-image { object-fit: contain; object-position: center; }
  .home-hero-shade { background: linear-gradient(90deg, rgba(10,18,23,.08) 0%, rgba(10,18,23,.22) 44%, rgba(10,18,23,.82) 100%); }
  .home-hero-content { position: relative; z-index: 1; display: flex; justify-content: flex-end; padding-block: 48px 52px; color: #fff; }
  .home-hero-copy { width: min(100%, 610px); }
  .hero-kicker { display: block; margin-bottom: 18px; font-size: 14px; font-weight: 700; }
  .home-hero h1 { max-width: 720px; margin-bottom: 18px; color: #fff; font-size: 48px; }
  .home-hero p { max-width: 650px; margin-bottom: 28px; color: #edf1f3; font-size: 19px; }
  .hero-actions { display: flex; gap: 12px; }
  .hero-note { display: block; margin-top: 18px; color: #d5dde1; font-size: 13px; }

  .trust-strip { border-bottom: 1px solid var(--c-border); background: #fff; }
  .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .trust-grid > div { display: grid; gap: 2px; padding: 22px 28px; border-right: 1px solid var(--c-border); }
  .trust-grid > div:first-child { border-left: 1px solid var(--c-border); }
  .trust-grid strong { color: var(--c-ink); font-size: 17px; }
  .trust-grid span { color: var(--c-text-muted); font-size: 13px; }

  .audience-grid { display: grid; border-top: 1px solid var(--c-border); }
  .audience-item { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; align-items: center; gap: 24px; padding: 28px 8px; border-bottom: 1px solid var(--c-border); }
  .audience-item:hover .audience-link { color: var(--c-primary-dark); }
  .audience-index { color: var(--c-primary); font-size: 15px; font-weight: 800; }
  .audience-item strong { color: var(--c-text-muted); font-size: 13px; }
  .audience-item h3 { margin: 4px 0 5px; font-size: 22px; }
  .audience-item p { margin-bottom: 0; color: var(--c-text-muted); }
  .audience-link { font-weight: 700; }

  .course-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .course-media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #e8ecee; }
  .course-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .course-card:hover .course-media img { transform: scale(1.025); }
  .course-body { padding: 26px; }
  .course-label { display: inline-block; margin-bottom: 12px; color: var(--c-primary-dark); font-size: 12px; font-weight: 800; }
  .course-label-green { color: var(--c-green); }
  .course-label-blue { color: var(--c-blue); }
  .course-body h3 { margin-bottom: 10px; font-size: 22px; }
  .course-body p { margin-bottom: 18px; color: var(--c-text-muted); }
  .course-body ul { display: grid; gap: 7px; margin: 0 0 22px; padding: 0; list-style: none; font-size: 14px; }
  .course-body li::before { content: ""; display: inline-block; width: 6px; height: 6px; margin: 0 9px 2px 0; border-radius: 50%; background: var(--c-primary); }

  .method-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 80px; align-items: start; }
  .method-cta { width: fit-content; margin-top: 10px; }
  .method-steps { display: grid; margin: 0; padding: 0; border-top: 1px solid var(--c-border); list-style: none; }
  .method-steps li { display: grid; grid-template-columns: 56px 1fr; gap: 18px; padding: 22px 0; border-bottom: 1px solid var(--c-border); }
  .method-steps > li > span { color: var(--c-primary); font-size: 14px; font-weight: 800; }
  .method-steps h3 { margin-bottom: 5px; font-size: 19px; }
  .method-steps p { margin-bottom: 0; color: var(--c-text-muted); font-size: 15px; }

  .training-grid { display: grid; grid-template-columns: 1.35fr 1fr 1fr; gap: 16px; }
  .training-grid figure { position: relative; min-height: 320px; margin: 0; overflow: hidden; border-radius: var(--radius-md); background: #dfe5e8; }
  .training-grid img { width: 100%; height: 100%; object-fit: cover; }
  .training-grid figcaption { position: absolute; right: 0; bottom: 0; left: 0; display: grid; padding: 34px 18px 16px; background: rgba(10,18,23,.72); color: #fff; }
  .training-grid figcaption span { color: #dce3e6; font-size: 13px; }
  .training-more { display: inline-block; margin-top: 22px; }

  .about-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  .about-video { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-md); background: #111; }
  .about-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .about-copy h2 { margin-bottom: 18px; font-size: 30px; }
  .about-copy p { color: var(--c-text-muted); }

  .latest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .latest-item > a { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #e7ecee; }
  .latest-item img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .latest-item > div { padding: 22px; }
  .latest-item span { color: var(--c-text-muted); font-size: 12px; }
  .latest-item h3 { margin: 9px 0 16px; font-size: 18px; }
  .all-news { margin-top: 28px; }

  .faq-list { border-top: 1px solid var(--c-border); }
  .faq-list details { border-bottom: 1px solid var(--c-border); }
  .faq-list summary { position: relative; padding: 20px 44px 20px 0; color: var(--c-ink); font-weight: 700; cursor: pointer; list-style: none; }
  .faq-list summary::after { content: "+"; position: absolute; top: 17px; right: 4px; color: var(--c-primary); font-size: 24px; }
  .faq-list details[open] summary::after { content: "-"; }
  .faq-list p { padding: 0 44px 20px 0; color: var(--c-text-muted); }

  @media (max-width: 900px) {
    .home-hero { height: 68vw; min-height: 560px; max-height: 620px; }
    .home-hero h1 { font-size: 42px; }
    .home-hero-copy { width: min(100%, 560px); }
    .course-grid, .latest-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .course-card:last-child, .latest-item:last-child { grid-column: 1 / -1; }
    .method-layout, .about-layout { grid-template-columns: 1fr; gap: 40px; }
    .training-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .training-grid figure:first-child { grid-column: 1 / -1; }
  }

  @media (max-width: 680px) {
    .home-hero { display: block; height: auto; min-height: 0; max-height: none; padding-top: 57.1429vw; background: #10181d; }
    .home-hero-image { bottom: auto; height: 57.1429vw; background: #e1d0c4; }
    .home-hero-shade { display: none; }
    .home-hero-content { padding-block: 32px 40px; }
    .home-hero-copy { width: 100%; }
    .home-hero h1 { font-size: 34px; }
    .home-hero p { font-size: 17px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .trust-grid { grid-template-columns: repeat(2, 1fr); }
    .trust-grid > div { padding: 16px; border-bottom: 1px solid var(--c-border); }
    .trust-grid > div:nth-child(odd) { border-left: 1px solid var(--c-border); }
    .audience-item { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; }
    .audience-link { grid-column: 2; font-size: 14px; }
    .course-grid, .latest-grid, .training-grid { grid-template-columns: 1fr; }
    .course-card:last-child, .latest-item:last-child, .training-grid figure:first-child { grid-column: auto; }
    .training-grid figure { min-height: 280px; }
  }
</style>
